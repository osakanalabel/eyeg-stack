# EyeG-Stack 環境設定（このファイルを .env にコピーして値を埋める）

# --- PostgreSQL ---
POSTGRES_USER=eyeg
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=eyeg_stack

# --- 公開URL（マジックリンクの組み立てに使う）---
# VPS では https://your-domain.example に変更
APP_BASE_URL=http://localhost:8080

# --- nginx の公開ポート（VPS で 80 にするなら 80）---
HTTP_PORT=8080

# --- Resend（メール送信）---
# 未設定の場合はメールを送らず、api コンテナのログにリンクを出力する（開発用）
RESEND_API_KEY=
# Resend で検証済みのドメインの差出人に変更すること。
# onboarding@resend.dev は Resend アカウント所有者宛にしか送れない
MAIL_FROM=EyeG-Stack <onboarding@resend.dev>
